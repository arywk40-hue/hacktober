# Copy to .env only when overriding the installed defaults.
CITETUTOR_OLLAMA_URL=http://127.0.0.1:11434
CITETUTOR_GENERATOR_MODEL=gemma3:4b
CITETUTOR_VERIFIER_MODEL=qwen2.5:3b
CITETUTOR_EMBEDDING_MODEL=nomic-embed-text
CITETUTOR_OCR_MODEL=glm-ocr:q8_0
CITETUTOR_OCR_TIMEOUT=600
CITETUTOR_DATA_DIR=data
# Distinct model families are enforced from local Ollama metadata.
# Changing embeddings requires deleting and re-uploading affected documents.

# OPTIONAL: enable metadata-only Sentry tracing. Leave blank for fully offline operation.
# Never add model prompts, answers, PDF text or filenames to trace attributes.
CITETUTOR_SENTRY_DSN=
CITETUTOR_SENTRY_TRACES_SAMPLE_RATE=1.0
